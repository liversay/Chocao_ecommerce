PORT=3000
MONGODB_URI=mongodb://localhost:27017/chocao
CLERK_SECRET_KEY=sk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
# Secreto de firma del webhook (stripe listen --print-secret en dev)
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_SUCCESS_URL=http://localhost:5173/checkout/success
STRIPE_CANCEL_URL=http://localhost:5173/checkout/cancel
FRONTEND_URL=http://localhost:5173
# CORS: lista blanca de orígenes separados por coma (si falta, usa FRONTEND_URL)
ALLOWED_ORIGINS=http://localhost:5173
# Nivel de logs: debug | info | warn | error
LOG_LEVEL=info
# OAuth 2.1 del servidor MCP: secreto de firma de los access tokens (obligatorio en prod)
OAUTH_JWT_SECRET=cambia-este-secreto
# Issuer público del AS/RS (URL del backend desplegado); en dev se infiere de PORT
# OAUTH_ISSUER=https://tu-backend.up.railway.app
